{
  "name": "@contour/cli",
  "version": "0.5.0",
  "description": "The Contour command line: turn a pull request diff into a schema-valid graph with your own model key, render it, and compose the comment.",
  "license": "MIT",
  "author": "Contour",
  "keywords": [
    "contour",
    "code-review",
    "architecture-diagram",
    "data-flow",
    "cli",
    "byok"
  ],
  "type": "module",
  "bin": {
    "contour": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@contour/renderer": "workspace:^",
    "@contour/schema": "workspace:^",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
