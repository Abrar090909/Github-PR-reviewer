{
  "name": "@contour/renderer",
  "version": "0.2.3",
  "description": "The Contour renderer: a schema-valid graph document in, a self-contained animated SVG out.",
  "license": "MIT",
  "author": "Contour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abrar090909/Github-PR-reviewer.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/Abrar090909/Github-PR-reviewer/tree/master/packages/renderer#readme",
  "keywords": [
    "contour",
    "code-review",
    "architecture-diagram",
    "data-flow",
    "svg",
    "diagram"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@contour/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
