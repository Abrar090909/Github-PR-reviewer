{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphDocument",
  "type": "object",
  "required": ["schemaVersion", "kind", "lenses", "lanes", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1"] },
    "kind": { "type": "string", "enum": ["graph"] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["architecture", "data-flow"] }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "delta", "lane"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "sublabel": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["service", "app", "module", "function", "route", "job", "queue", "datastore", "cache", "external", "ui", "config", "test", "package", "other"]
          },
          "delta": {
            "type": "string",
            "enum": ["added", "modified", "removed", "unchanged", "new"]
          },
          "lane": { "type": "string", "minLength": 1 },
          "group": { "type": "string" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "startLine": { "type": "integer" },
                "endLine": { "type": "integer" }
              }
            }
          },
          "riskScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "riskReasons": { "type": "array", "items": { "type": "string" } },
          "behaviorDelta": { "type": ["string", "null"] },
          "testCoverage": { "type": "string", "enum": ["covered", "none-in-diff", "not-applicable"] },
          "fanIn": { "type": "number" },
          "churnScore": { "type": "number" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "delta": { "type": "string" },
          "label": { "type": "string" },
          "animated": { "type": "boolean" }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "participants", "messages"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["node"],
              "properties": {
                "node": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "from", "to", "label"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string" },
                "delta": { "type": "string" },
                "animated": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "lens"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "lens": { "type": "string" },
          "summary": { "type": "string" },
          "defaultOpen": { "type": "boolean" }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "filesChanged": { "type": "integer" },
        "additions": { "type": "integer" },
        "deletions": { "type": "integer" },
        "chips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
