{
  "name": "@contour/schema",
  "version": "0.2.1",
  "description": "The Contour contract: versioned schemas for architecture / data-flow graph documents, baseline patches, config and render manifests.",
  "license": "MIT",
  "author": "Contour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abrar090909/Github-PR-reviewer.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/Abrar090909/Github-PR-reviewer/tree/master/packages/schema#readme",
  "keywords": [
    "contour",
    "code-review",
    "architecture-diagram",
    "data-flow",
    "json-schema",
    "zod"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "default": "./dist/examples/index.js"
    },
    "./json-schema/*.json": "./json-schema/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "json-schema",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && pnpm run schema:emit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema:emit": "tsx scripts/emit-artifacts.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "ajv": "^8.20.0",
    "tsx": "4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
