# Contour environment variables. Copy to apps/web/.env.local and fill in.
# Only the hosted GitHub App needs these; the CLI and the Action only need a model key.

# ─── GitHub App ───────────────────────────────────────────────────────────────
# The app's slug from https://github.com/settings/apps/<app-slug>, used to build
# the install link. Or set the full link with NEXT_PUBLIC_GITHUB_APP_INSTALL_URL.
NEXT_PUBLIC_GITHUB_APP_SLUG=
# NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=

# Numeric App ID from the GitHub App settings page
GITHUB_APP_ID=

# The app's PEM private key, raw or base64-encoded
# Generate: base64 -w 0 private-key.pem
GITHUB_APP_PRIVATE_KEY=

# Secret set in the GitHub App settings, used to verify webhook signatures
GITHUB_WEBHOOK_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Upstash Redis and QStash ─────────────────────────────────────────────────
# https://console.upstash.com (the *_REST_* names are accepted too)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io

# ─── Model ────────────────────────────────────────────────────────────────────
# The hosted app analyzes with Gemini; both values are required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional, for `contour analyze --provider openai` from the CLI
OPENAI_API_KEY=
# Optional Jev advisory review signal for `contour analyze --jev-review`
TYPESAFE_API_KEY=

# ─── Hosted app limits ────────────────────────────────────────────────────────
MAX_DIFF_BYTES_PER_CALL=400000
MAX_FILES_PER_PR=300
MAX_JOBS_PER_HOUR=30

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
