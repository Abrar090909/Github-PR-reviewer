# Contour Environment Variables — copy to .env.local and fill in values

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Your GitHub App's slug/name from https://github.com/settings/apps/<app-slug>
# Used to generate the installation URL (https://github.com/apps/<slug>/installations/new)
NEXT_PUBLIC_GITHUB_APP_SLUG=pr-reviewer-2026

# Numeric App ID from GitHub App settings page
GITHUB_APP_ID=

# PEM private key for the GitHub App, base64-encoded
# Generate: cat private-key.pem | base64 -w 0
GITHUB_APP_PRIVATE_KEY=

# Secret you set in GitHub App settings for webhook signature verification
GITHUB_WEBHOOK_SECRET=

# OAuth App credentials for dashboard login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Queue (Upstash Redis / QStash) ──────────────────────────────────────────
# From: https://console.upstash.com/redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
# QStash signing keys (for verifying worker callbacks)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Anthropic (default provider)
ANTHROPIC_API_KEY=

# Optional: Gemini
GEMINI_API_KEY=

# Optional: OpenAI
OPENAI_API_KEY=

# ─── Worker Config ────────────────────────────────────────────────────────────
# Max diff lines sent to LLM per call (controls cost)
MAX_DIFF_LINES_PER_CALL=800

# Max analysis jobs per installation per hour
MAX_JOBS_PER_HOUR=30

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
